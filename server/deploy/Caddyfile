# /etc/caddy/Caddyfile — HTTPS certificates are fetched and renewed by Caddy itself.
# No access log is configured, so client IP addresses are not written anywhere.

rigsweep.com {
	root * /var/www/rigsweep
	encode zstd gzip
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.rigsweep.com {
	redir https://rigsweep.com{uri} permanent
}

stats.rigsweep.com {
	encode zstd gzip
	header -Server
	reverse_proxy 127.0.0.1:8787 {
		# the collector reads the client IP from here (rate limit and country only, never stored)
		header_up X-Real-IP {client_ip}
	}
}
