# Copy to /etc/rigsweep-stats.env on the server, then: chmod 600 /etc/rigsweep-stats.env
# Never commit the real file.

# DigitalOcean managed Postgres: use the cluster's PRIVATE host (VPC) and port 25060.
# For full certificate checking, download the cluster's CA certificate to /etc/rigsweep-ca.crt and use
#   ?sslmode=verify-full&sslrootcert=/etc/rigsweep-ca.crt
DATABASE_URL=postgres://rigsweep_stats:CHANGE_ME@private-db-xxxx.db.ondigitalocean.com:25060/rigsweep?sslmode=verify-full&sslrootcert=/etc/rigsweep-ca.crt

BIND=127.0.0.1:8787

# The dashboard at https://stats.rigsweep.com/admin. Use a long random password:
#   openssl rand -base64 30
ADMIN_USER=admin
ADMIN_PASSWORD=

# Country lookup (only the 2-letter code is stored). Filled by update-geoip.sh.
GEOIP_DB=/var/lib/rigsweep-geo/country.mmdb

# Set to 1 only if Cloudflare proxies stats.rigsweep.com (then its CF-IPCountry header is used).
TRUST_CF_COUNTRY=0

RATE_MAX=30
RUST_LOG=info
