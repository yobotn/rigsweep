{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RigSweep",
  "version": "0.5.1",
  "identifier": "io.github.rigsweep",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RigSweep",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "RigSweep contributors",
    "copyright": "MIT License - RigSweep contributors",
    "category": "Utility",
    "shortDescription": "Free resources on Windows dev machines cluttered by AI-agent sessions",
    "longDescription": "RigSweep frees CPU, RAM and disk on Windows 10/11 dev laptops: reversible service/telemetry tweaks, stale Node and AI-agent CLI cleanup, a before/after Boost Report and a Chrome tab helper.",
    "homepage": "https://rigsweep.com",
    "license": "MIT",
    "resources": {
      "../chrome-extension/": "chrome-extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English",
          "German",
          "Spanish",
          "French",
          "Italian",
          "PortugueseBR",
          "Russian",
          "Japanese",
          "Korean",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    },
    "licenseFile": "windows/license.txt"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwM0E3Nzc0NkRFNjFFOTgKUldTWUh1WnRkSGM2RUtnVk1NMm5PWDhodW1EaGwyZU9nNkdYYWNoUXFUS3dqRS9mcjY4a3M3MnUK",
      "endpoints": ["https://github.com/yobotn/rigsweep/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
