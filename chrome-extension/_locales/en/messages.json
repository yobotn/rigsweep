  "shareTitle": {
    "message": "📊 Anonymous stats"
  },
  "shareHint": {
    "message": "Once a week RigSweep Tabs sends anonymous counts: how many tabs it slept and closed, how many tabs and windows are open, whether auto-sleep is on, and the browser and extension version. They feed the public counters on rigsweep.com. Never sent: URLs, page titles, sites, your patterns or anything you browse. Your IP address is used only to look up the country and is never stored."
  },
  "shareToggle": {
    "message": "Share anonymous weekly stats"
